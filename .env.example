# Copy to .env for local development. Never commit the real .env file.
# On Fly.io these values are set with `flyctl secrets set`.

# PostgreSQL connection string (Supabase Transaction pooler, port 6543).
DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
# Supabase pooler certificate is not trusted by Node's default CA store inside
# the container. Set this to 0 for the app process.
NODE_TLS_REJECT_UNAUTHORIZED=0

# Encrypts provider API keys at rest. Keep it stable: changing it makes
# previously stored provider keys undecryptable.
SESSION_SECRET=replace-with-a-long-random-string

# Supabase Auth. The publishable key is safe to expose; the secret key is not
# required by the app.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Local development ports.
PORT=5000
BASE_PATH=/
