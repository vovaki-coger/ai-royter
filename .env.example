# Copy to .env for local development. Never commit the real .env file.
# On Render these values are configured in the service environment instead.

# PostgreSQL connection string (local Docker/Postgres or Render).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_router

# Encrypts provider API keys at rest. Keep it stable: changing it makes
# previously stored provider keys undecryptable.
SESSION_SECRET=replace-with-a-long-random-string

# Clerk application keys. The publishable key is needed by both the browser
# and the API; the secret key is server-only.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Optional: only needed when the Clerk Frontend API is proxied through the
# app (requires proxy configuration in the Clerk dashboard).
# VITE_CLERK_PROXY_URL=/api/__clerk

# Local development ports. Render injects PORT automatically.
PORT=5000
BASE_PATH=/
